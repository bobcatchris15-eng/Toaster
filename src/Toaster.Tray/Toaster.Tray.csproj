<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Toaster</AssemblyName>
    <ApplicationIcon>..\..\assets\Toaster.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon only brands the executable. Embedding the same file lets the
         form set its own window, taskbar and tray icon without probing the exe. -->
    <EmbeddedResource Include="..\..\assets\Toaster.ico" LogicalName="Toaster.ico" />
  </ItemGroup>
</Project>
